{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "/mnt/bn/xiangtai-training-data/env/miniconda3/envs/sqy-rl/bin/python"
    },
    {
      "name": "Debug Qwen3VL SFT (single GPU lite)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/qwenvl/train/train_qwen.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "args": [
        "--model_name_or_path",
        "Qwen/Qwen3-VL-2B-Instruct",
        "--dataset_use",
        "videoreward",
        "--data_flatten",
        "True",
        "--tune_mm_vision",
        "False",
        "--tune_mm_mlp",
        "True",
        "--tune_mm_llm",
        "True",
        "--using_cot",
        "True",
        "--output_dir",
        "${workspaceFolder}/output/qwen3vl-2b-baseline-debug",
        "--num_train_epochs",
        "1",
        "--per_device_train_batch_size",
        "2",
        "--per_device_eval_batch_size",
        "1",
        "--gradient_accumulation_steps",
        "1",
        "--max_pixels",
        "50176",
        "--min_pixels",
        "784",
        "--eval_strategy",
        "no",
        "--save_strategy",
        "no",
        "--learning_rate",
        "5e-5",
        "--weight_decay",
        "0",
        "--warmup_ratio",
        "0.03",
        "--max_grad_norm",
        "1",
        "--lr_scheduler_type",
        "cosine",
        "--logging_steps",
        "1",
        "--model_max_length",
        "8192",
        "--gradient_checkpointing",
        "True",
        "--dataloader_num_workers",
        "0",
        "--run_name",
        "qwen3vl-2b-baseline-debug",
        "--report_to",
        "none"
      ]
    }
  ]
}